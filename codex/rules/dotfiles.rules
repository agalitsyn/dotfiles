# Shell command allowlist matching claude/settings.json.
# Codex matches argv prefixes; Bash(command:*) maps to ["command"].
# Use env GOTOOLCHAIN=... go ... instead of shell assignments so the command
# matches these rules, including when selecting a different Go toolchain.
# WebFetch, WebSearch, and MCP permissions are not shell execution rules.

prefix_rule(
    pattern=["env"],
    decision="allow",
    match=["env", "env GOTOOLCHAIN=go1.26.4 go test -race ./..."],
)
prefix_rule(pattern=["printenv"], decision="allow")
prefix_rule(pattern=["rm"], decision="allow")
prefix_rule(pattern=["mv"], decision="allow")
prefix_rule(pattern=["chmod"], decision="allow")
prefix_rule(pattern=["cat"], decision="allow")
prefix_rule(pattern=["wc"], decision="allow")
prefix_rule(pattern=["tee"], decision="allow")
prefix_rule(pattern=["grep"], decision="allow")
prefix_rule(pattern=["sed"], decision="allow")
prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["tree"], decision="allow")
prefix_rule(pattern=["xargs"], decision="allow")
prefix_rule(pattern=["jq"], decision="allow")
prefix_rule(pattern=["open"], decision="allow")
prefix_rule(pattern=["find"], decision="allow")
prefix_rule(pattern=["mkdir"], decision="allow")
prefix_rule(pattern=["ls"], decision="allow")
prefix_rule(pattern=["cd"], decision="allow")
prefix_rule(pattern=["source"], decision="allow")
prefix_rule(pattern=["awk"], decision="allow")
prefix_rule(pattern=["head"], decision="allow")
prefix_rule(pattern=["tail"], decision="allow")
prefix_rule(pattern=["echo"], decision="allow")
prefix_rule(pattern=["sort"], decision="allow")
prefix_rule(pattern=["uniq"], decision="allow")
prefix_rule(pattern=["cut"], decision="allow")
prefix_rule(pattern=["which"], decision="allow")
prefix_rule(pattern=["diff"], decision="allow")
prefix_rule(pattern=["git"], decision="allow")
prefix_rule(pattern=["gh"], decision="allow")
prefix_rule(pattern=["glab"], decision="allow")
prefix_rule(pattern=["acli"], decision="allow")
prefix_rule(pattern=["sentry-cli"], decision="allow")
prefix_rule(pattern=["kubectl"], decision="allow")
prefix_rule(pattern=["make"], decision="allow")
prefix_rule(pattern=["go"], decision="allow")
prefix_rule(pattern=["gofmt"], decision="allow")
prefix_rule(pattern=["golangci-lint"], decision="allow")
prefix_rule(pattern=["python"], decision="allow")
prefix_rule(pattern=["python3"], decision="allow")
prefix_rule(pattern=["uv"], decision="allow")
prefix_rule(pattern=["poetry"], decision="allow")
prefix_rule(pattern=["docker"], decision="allow")
prefix_rule(pattern=["node"], decision="allow")
prefix_rule(pattern=["bun"], decision="allow")
prefix_rule(pattern=["npm"], decision="allow")
prefix_rule(pattern=["npx"], decision="allow")
prefix_rule(pattern=["pnpm"], decision="allow")
prefix_rule(pattern=["curl"], decision="allow")
prefix_rule(pattern=["hurl"], decision="allow")
prefix_rule(pattern=["psql"], decision="allow")
prefix_rule(pattern=["peer-chat.py"], decision="allow")
prefix_rule(pattern=["agtermctl"], decision="allow")

# Additional Codex command retained from the existing rules.
prefix_rule(pattern=["sentry"], decision="allow")
