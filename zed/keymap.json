[
  {
    "context": "Editor",
    "bindings": {
      "ctrl-0": "pane::RevealInProjectPanel"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-[": "pane::GoBack"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-]": "pane::GoForward"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-shift-backspace": "pane::GoBack"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-shift-c": "workspace::CopyRelativePath"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "f7": "project_panel::SelectNextGitEntry"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd+shift+g": "git_panel::OpenMenu"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd+shift+o": "outline::Toggle"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-k cmd-g": "editor::CopyPermalinkToLine"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-g": "git_panel::ToggleFocus"
    }
  },

  {
    "context": "Workspace",
    "bindings": {
      "cmd-e": "tab_switcher::Toggle"
    }
  },

  // macOS native window tabs ("use_system_window_tabs": true). Zed ships these
  // actions unbound. They are registered on the Workspace only while the window
  // has >1 tab (MergeAllWindows only while >1 tab group), so they are inert --
  // including in the command palette -- until tabs actually exist.
  //   cmd-[ / cmd-]           history within a project (GoBack/GoForward)
  //   ctrl-cmd-[ / ctrl-cmd-] between projects (window tabs)
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-cmd-]": "window::ShowNextWindowTab",
      "ctrl-cmd-[": "window::ShowPreviousWindowTab",
      "ctrl-cmd-m": "window::MergeAllWindows",
      "ctrl-cmd-n": "window::MoveTabToNewWindow"
    }
  }
]
