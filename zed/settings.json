{
  "use_system_window_tabs": true,
  "cli_default_open_behavior": "new_window",
  "git_panel": {
    "group_by": "staging",
    "tree_view": true,
    "dock": "left",
  },
  "debugger": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "terminal": {
    "dock": "bottom",
    "font_family": "IosevkaTerm Nerd Font Mono",
    "copy_on_select": true,
    "default_height": 280,
  },
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
    },
    "enabled_in_text_threads": false,
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Bearded Icon Theme",
    "dark": "Bearded Icon Theme"
  },
  "vim_mode": false,
  "relative_line_numbers": "disabled",
  "cursor_blink": false,
  "scrollbar": {
    "show": "auto",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  // TODO/NOTE/FIXME chips, mirroring vscode's todohighlight.
  // Requires the "comment" extension (Comments Highlighter), which injects a tag
  // grammar into (comment) nodes. Tag groups are fixed by the extension:
  //   constant.comment.todo  -> TODO WIP MAYBE QUESTION ?
  //   string.comment.info    -> NOTE XXX INFO DOCS PERF TEST *
  //   property.comment.error -> FIXME FIX BUG ERROR DELETE !
  //   keyword.comment.warn   -> HACK WARNING WARN SAFETY IMPORTANT #
  // The base capture styles the tag itself; ".prefix" (the // or #) and ".text"
  // (everything after the tag) are reset so only the tag gets the chip.
  "theme_overrides": {
    "One Dark": {
      "syntax": {
        "constant.comment.todo": { "color": "#000000", "background_color": "#a7c7e7", "font_weight": 400 },
        "constant.comment.todo.prefix": { "color": "#5c6370", "background_color": "#00000000", "font_weight": 500 },
        "constant.comment.todo.text": { "color": "#8b98a8", "background_color": "#00000000", "font_weight": 500 },
        "string.comment.info": { "color": "#ffffff", "background_color": "#a7c7e7", "font_weight": 400 },
        "string.comment.info.prefix": { "color": "#5c6370", "background_color": "#00000000", "font_weight": 500 },
        "string.comment.info.text": { "color": "#8b98a8", "background_color": "#00000000", "font_weight": 500 },
        "property.comment.error": { "color": "#000000", "background_color": "#e7a7a7", "font_weight": 400 },
        "property.comment.error.prefix": { "color": "#5c6370", "background_color": "#00000000", "font_weight": 500 },
        "property.comment.error.text": { "color": "#a88b8b", "background_color": "#00000000", "font_weight": 500 },
        "keyword.comment.warn": { "color": "#000000", "background_color": "#e7cba7", "font_weight": 400 },
        "keyword.comment.warn.prefix": { "color": "#5c6370", "background_color": "#00000000", "font_weight": 500 },
        "keyword.comment.warn.text": { "color": "#a89b8b", "background_color": "#00000000", "font_weight": 500 },
      },
    },
    "One Light": {
      "syntax": {
        "constant.comment.todo": { "color": "#000000", "background_color": "#a7c7e7", "font_weight": 400 },
        "constant.comment.todo.prefix": { "color": "#a0a1a7", "background_color": "#00000000", "font_weight": 500 },
        "constant.comment.todo.text": { "color": "#7c8794", "background_color": "#00000000", "font_weight": 500 },
        "string.comment.info": { "color": "#ffffff", "background_color": "#a7c7e7", "font_weight": 400 },
        "string.comment.info.prefix": { "color": "#a0a1a7", "background_color": "#00000000", "font_weight": 500 },
        "string.comment.info.text": { "color": "#7c8794", "background_color": "#00000000", "font_weight": 500 },
        "property.comment.error": { "color": "#000000", "background_color": "#e7a7a7", "font_weight": 400 },
        "property.comment.error.prefix": { "color": "#a0a1a7", "background_color": "#00000000", "font_weight": 500 },
        "property.comment.error.text": { "color": "#94787c", "background_color": "#00000000", "font_weight": 500 },
        "keyword.comment.warn": { "color": "#000000", "background_color": "#e7cba7", "font_weight": 400 },
        "keyword.comment.warn.prefix": { "color": "#a0a1a7", "background_color": "#00000000", "font_weight": 500 },
        "keyword.comment.warn.text": { "color": "#948a78", "background_color": "#00000000", "font_weight": 500 },
      },
    },
  },
  "auto_reveal_entries": true,
  "project_panel": {
    "dock": "left",
    "auto_fold_dirs": false,
    "auto_reveal_entries": true,
  },
  "preferred_line_length": 140,
  "soft_wrap": "preferred_line_length",
  "use_autoclose": false,
  "agent": {
    "tool_permissions": {
      "default": "allow",
    },
    "dock": "right",
    "sidebar_side": "right",
    "profiles": {
      "ask": {
        "name": "Ask",
        "tools": {
          "search_web": true,
          "symbol_info": true,
          "open": true,
          "terminal": true,
          "contents": true,
          "diagnostics": true,
          "fetch": true,
          "list_directory": true,
          "now": true,
          "find_path": true,
          "read_file": true,
          "grep": true,
          "thinking": true,
          "batch_tool": true,
        },
        "enable_all_context_servers": false,
        "context_servers": {},
      },
      "write": {
        "name": "Write",
        "tools": {
          "search_web": true,
          "open": true,
          "create_directory": true,
          "terminal": true,
          "batch_tool": true,
          "code_actions": true,
          "code_symbols": true,
          "contents": true,
          "copy_path": true,
          "create_file": true,
          "delete_path": false,
          "diagnostics": true,
          "edit_file": true,
          "fetch": true,
          "list_directory": true,
          "move_path": false,
          "now": true,
          "find_path": true,
          "read_file": true,
          "grep": true,
          "rename": true,
          "symbol_info": true,
          "thinking": true,
        },
        "enable_all_context_servers": true,
        "context_servers": {},
      },
    },
    "default_profile": "write",
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-3-7-sonnet-latest",
    },
  },
  "context_servers": {
    "mcp-server-brave-search": {
      "settings": {
        "brave_api_key": "",
      },
    },
    "mcp-server-sequential-thinking": {
      "settings": {},
    },
  },
  "preview_tabs": {
    "enable_preview_from_multibuffer": false,
    "enable_preview_file_from_code_navigation": false,
    "enable_preview_from_project_panel": false,
    "enabled": false,
    "enable_preview_from_file_finder": false,
    "enable_keep_preview_on_code_navigation": false,
  },
  "tabs": {
    "git_status": true,
    "file_icons": true,
    "show_close_button": "hover",
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": true,
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.venv",
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/target",
    "**/.rope*",
    "**/*_cache",
    "**/__pycache__",
    "**/.*-version",
    "**/.DS_Store",
  ],
  "base_keymap": "VSCode",
  "autosave": "on_focus_change",
  "buffer_font_size": 17.5,
  "buffer_font_family": "Iosevka Fixed",
  "buffer_font_weight": 500,
  "buffer_line_height": "comfortable",
  "ui_font_family": ".ZedSans",
  "ui_font_size": 17,
  "agent_ui_font_size": 18,
  "confirm_quit": true,
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true,
    },
  },
  "inlay_hints": {
    "enabled": false,
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
  },
  "show_edit_predictions": true,
  "collaboration_panel": {
    "button": false,
  },
  "auto_signature_help": true,
  "lsp": {
    "pyright": {
      "settings": {
        "python.analysis": {
          "diagnosticMode": "workspace",
          "typeCheckingMode": "strict",
        },
        "python": {
          "pythonPath": ".venv/bin/python",
        },
      },
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "lineLength": 140,
        },
      },
    },
    "gopls": {
      "initialization_options": {
        "gofumpt": true,
        "usePlaceholders": true,
        // gopls does NOT read .golangci.yml. "staticcheck": true enables *every*
        // staticcheck analyzer, including non-default ST* style checks that
        // golangci-lint v2 disables by default. The "analyses" opt-outs below
        // mirror golangci-lint's default staticcheck set:
        //   ["all", "-ST1000", "-ST1003", "-ST1016", "-ST1020", "-ST1021", "-ST1022"]
        // (golangci-lint/v2/pkg/golinters/staticcheck/staticcheck.go)
        "staticcheck": true,
        "analyses": {
          "ST1000": false, // incorrect or missing package comment
          "ST1003": false, // poorly chosen identifier (naming conventions)
          "ST1016": false, // inconsistent method receiver names
          "ST1020": false, // comment on exported function
          "ST1021": false, // comment on exported type
          "ST1022": false, // comment on exported var/const
        },
        "codelenses": {
          "gc_details": true,
          "generate": true,
          "regenerate_cgo": true,
          "tidy": true,
          "upgrade_dependency": true,
          "vendor": true,
        },
        "hints": {
          "assignVariableTypes": true,
          "compositeLiteralFields": true,
          "compositeLiteralTypes": true,
          "constantValues": true,
          "functionTypeParameters": true,
          "parameterNames": true,
          "rangeVariableTypes": true,
        },
      },
    },
  },
  "languages": {
    "HTML": {
      "tab_size": 2,
      "format_on_save": "off",
    },
    "CSS": {
      "tab_size": 2,
    },
    "JavaScript": {
      "tab_size": 2,
    },
    "Python": {
      "language_servers": ["pyright", "ruff"],
      "format_on_save": "on",
      "formatter": [
        {
          "code_action": "source.organizeImports.ruff",
        },
        {
          "code_action": "source.fixAll.ruff",
        },
        {
          "language_server": {
            "name": "ruff",
          },
        },
      ],
    },
    "YAML": {
      "format_on_save": "off",
    },
  },
}
