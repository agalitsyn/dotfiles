{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "lazygit",
            "type": "shell",
            "command": "lazygit",
            "args": [
                ""
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "focus": true,
                "echo": false,
                "reveal": "always",
                "showReuseMessage": false,
                "panel": "new",
                "close": true,
                "clear": true
            }
        },
        {
            // Git history of the focused file: lazygit in filter mode
            // (commits/reflog/stash scoped to `git log -- <path>`).
            // cwd is the file's own dir so lazygit finds the enclosing repo
            // even when it isn't the workspace root (monorepos, nested repos).
            "icon": {"id": "history"},
            "label": "git_file_history",
            "type": "shell",
            "command": "lazygit",
            "args": [
                "--filter",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [],
            "presentation": {
                "focus": true,
                "echo": false,
                "reveal": "always",
                "showReuseMessage": false,
                "panel": "new",
                "close": true,
                "clear": true
            }
        },
        {
            "icon": {"id": "git-branch"},
            "label": "copy_git_link",
            "type": "shell",
            "command": "echo \"https://gitlab.gx-testdmnweb.com/dex/trader-bot/-/blob/$(git rev-parse --abbrev-ref HEAD)/${relativeFile}?ref_type=heads#L${lineNumber}\" | pbcopy",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "panel": "shared",
                "showReuseMessage": false,
                "focus": false,
                "echo": false,
                "close": true,
                "clear": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
        }
    ]
}
